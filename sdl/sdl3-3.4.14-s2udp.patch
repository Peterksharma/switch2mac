+
+static Sint16 S2UDP_AxisFromFloat(float value)
+{
+    if (value < -1.0f) value = -1.0f;
+    if (value > 1.0f) value = 1.0f;
+    return (Sint16)(value * 32767.0f);
+}
+
+static Sint16 S2UDP_AxisFromTrigger(Uint8 value)
+{
+    // 0..255 -> SDL_JOYSTICK_AXIS_MIN..MAX (rest = fully negative)
+    return (Sint16)(((int)value * 65535 / 255) - 32768);
+}
+
+static void S2UDP_JoystickUpdate(SDL_Joystick *joystick)
+{
+    static const struct { Uint8 index; Uint32 mask; } button_map[] = {
+        { 0, S2_BTN_B }, { 1, S2_BTN_A }, { 2, S2_BTN_Y }, { 3, S2_BTN_X },
+        { 4, S2_BTN_MINUS }, { 5, S2_BTN_HOME }, { 6, S2_BTN_PLUS },
+        { 7, S2_BTN_LSTICK }, { 8, S2_BTN_RSTICK },
+        { 9, S2_BTN_L }, { 10, S2_BTN_R },
+        { 11, S2_BTN_UP }, { 12, S2_BTN_DOWN }, { 13, S2_BTN_LEFT }, { 14, S2_BTN_RIGHT },
+        { 15, S2_BTN_CAPTURE }, { 16, S2_BTN_GR }, { 17, S2_BTN_GL }, { 18, S2_BTN_C },
+        { 19, S2_BTN_ZR },
+        { 20, S2_BTN_ZL },
+    };
+    S2UDP_Slot *slot = (S2UDP_Slot *)joystick->hwdata;
+    Uint64 timestamp = SDL_GetTicksNS();
+    int i;
+
+    S2UDP_PumpAll();
+    if (!slot || !slot->present) {
+        return;
+    }
+
+    for (i = 0; i < (int)SDL_arraysize(button_map); ++i) {
+        SDL_SendJoystickButton(timestamp, joystick, button_map[i].index,
+                               (slot->buttons & button_map[i].mask) != 0);
+    }
+    SDL_SendJoystickAxis(timestamp, joystick, 0, S2UDP_AxisFromFloat(slot->lx));
+    SDL_SendJoystickAxis(timestamp, joystick, 1, S2UDP_AxisFromFloat(-slot->ly));
+    SDL_SendJoystickAxis(timestamp, joystick, 2, S2UDP_AxisFromFloat(slot->rx));
+    SDL_SendJoystickAxis(timestamp, joystick, 3, S2UDP_AxisFromFloat(-slot->ry));
+    SDL_SendJoystickAxis(timestamp, joystick, 4, S2UDP_AxisFromTrigger(slot->lt));
+    SDL_SendJoystickAxis(timestamp, joystick, 5, S2UDP_AxisFromTrigger(slot->rt));
+
+    // Sustain active rumble: the bridge expires intents after 500 ms so a
+    // crashed consumer can never leave the motor running.
+    if ((slot->rumble_strong || slot->rumble_weak) &&
+        SDL_GetTicks() - slot->last_rumble_ms >= RUMBLE_RESEND_MS) {
+        S2UDP_SendRumble(slot);
+    }
+}
+
+static void S2UDP_JoystickClose(SDL_Joystick *joystick)
+{
+    joystick->hwdata = NULL;
+}
+
+static void S2UDP_JoystickQuit(void)
+{
+    int k;
+    for (k = 0; k < S2UDP_MAX_SLOTS; ++k) {
+        if (s_slots[k].sock >= 0) {
+            close(s_slots[k].sock);
+        }
+        SDL_zero(s_slots[k]);
+        s_slots[k].sock = -1;
+    }
+    s_initialized = false;
+}
