diff --git a/src/joystick/darwin/SDL_s2udpjoystick.c b/src/joystick/darwin/SDL_s2udpjoystick.c
new file mode 100644
index 0000000..5ba01a2
--- /dev/null
+++ b/src/joystick/darwin/SDL_s2udpjoystick.c
@@ -0,0 +1,519 @@
+/*
+  SDL_s2udpjoystick.c — joystick backend fed by the s2bridge UDP streams.
+
+  A Nintendo Switch 2 Pro Controller cannot be reached directly from this
+  process over Bluetooth on macOS (its BLE protocol needs a CoreBluetooth
+  client and a keep-alive regimen; see the companion bridge). Instead, a
+  user-space bridge process decodes each controller and re-broadcasts state
+  datagrams on localhost UDP; this driver turns those streams back into SDL
+  joysticks with rumble.
+
+  Multi-controller model: the bridge serves slot k on port BASE_PORT + k
+  (k in 0..MAX_SLOTS-1). The port number IS the controller identity — this
+  driver keeps one socket per slot, and each streaming slot appears as its
+  own joystick. Rumble written to a slot's socket reaches exactly that
+  controller.
+
+  Wire protocol (all little-endian, must match bridge.py):
+    State  (bridge -> us, 44 bytes):
+      "S2B1" | u32 seq | u32 buttons | f32 lx,ly,rx,ry | u8 lt,rt
+             | u16 battery_mv | i16 gyro[3] | i16 accel[3]
+    Rumble (us -> bridge, 6 bytes): "S2R1" | u8 strong | u8 weak
+    Any datagram we send also registers us as a subscriber (30 s TTL),
+    so a "hello" is sent every HELLO_INTERVAL_MS per slot.
+
+  Presence: a slot's joystick exists while its state datagrams are fresher
+  than PRESENCE_TIMEOUT_MS; SDL hotplug events fire on both edges. Because
+  apps may enumerate immediately after SDL_Init (gopher64's input wizard
+  does), Init synchronously waits up to ~300 ms for already-streaming slots.
+
+  Exposed layout per joystick (fixed):
+    buttons: 0=B 1=A 2=Y 3=X 4=MINUS 5=HOME 6=PLUS 7=LSTICK 8=RSTICK
+             9=L 10=R 11=DPAD_UP 12=DPAD_DOWN 13=DPAD_LEFT 14=DPAD_RIGHT
+             15=CAPTURE 16=GR 17=GL 18=C 19=ZR (GameCube Z) 20=ZL
+    axes:    0=LX 1=LY 2=RX 3=RY 4=ZL 5=ZR  (Y inverted to SDL's
+             down-positive convention; triggers span the full Sint16 range)
+*/
+
+#include "SDL_internal.h"
+
+#ifdef SDL_PLATFORM_MACOS
+
+#include "../SDL_sysjoystick.h"
+#include "../SDL_joystick_c.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#define S2UDP_BASE_PORT       24800
+#define S2UDP_MAX_SLOTS       4
+#define S2UDP_STATE_SIZE      44
+#define PRESENCE_TIMEOUT_MS   2000
+#define HELLO_INTERVAL_MS     5000
+#define RUMBLE_RESEND_MS      200
+
+// Switch button bitmask (subset we map), matching the BLE report layout.
+#define S2_BTN_Y       0x00000001u
+#define S2_BTN_X       0x00000002u
+#define S2_BTN_B       0x00000004u
+#define S2_BTN_A       0x00000008u
+#define S2_BTN_R       0x00000040u
+#define S2_BTN_ZR      0x00000080u
+#define S2_BTN_MINUS   0x00000100u
+#define S2_BTN_PLUS    0x00000200u
+#define S2_BTN_RSTICK  0x00000400u
+#define S2_BTN_LSTICK  0x00000800u
+#define S2_BTN_HOME    0x00001000u
+#define S2_BTN_CAPTURE 0x00002000u
+#define S2_BTN_C       0x00004000u
+#define S2_BTN_DOWN    0x00010000u
+#define S2_BTN_UP      0x00020000u
+#define S2_BTN_RIGHT   0x00040000u
+#define S2_BTN_LEFT    0x00080000u
+#define S2_BTN_L       0x00400000u
+#define S2_BTN_ZL      0x00800000u
+#define S2_BTN_GR      0x01000000u
+#define S2_BTN_GL      0x02000000u
+
+typedef struct
+{
+    int sock;                    // -1 when unavailable
+    bool present;
+    SDL_JoystickID instance_id;
+    Uint32 buttons;
+    float lx, ly, rx, ry;
+    Uint8 lt, rt;
+    Uint64 last_state_ms;
+    Uint64 last_hello_ms;
+    Uint16 rumble_strong, rumble_weak;
+    Uint64 last_rumble_ms;
+    char name[64];               // bridge-provided ("S2N1"); may be custom
+} S2UDP_Slot;
+
+static S2UDP_Slot s_slots[S2UDP_MAX_SLOTS];
+static bool s_initialized = false;
+
+static Uint32 read_u32(const Uint8 *p) { return (Uint32)(p[0] | (p[1] << 8) | (p[2] << 16) | ((Uint32)p[3] << 24)); }
+static float read_f32(const Uint8 *p)
+{
+    Uint32 bits = read_u32(p);
+    float value;
+    SDL_memcpy(&value, &bits, sizeof value);
+    return value;
+}
+
+static void S2UDP_SendHello(S2UDP_Slot *slot)
+{
+    if (slot->sock >= 0) {
+        (void)send(slot->sock, "", 0, 0);
+        slot->last_hello_ms = SDL_GetTicks();
+    }
+}
+
+static void S2UDP_SendRumble(S2UDP_Slot *slot)
+{
+    if (slot->sock >= 0) {
+        Uint8 pkt[6] = { 'S', '2', 'R', '1',
+                         (Uint8)(slot->rumble_strong >> 8),
+                         (Uint8)(slot->rumble_weak >> 8) };
+        (void)send(slot->sock, pkt, sizeof pkt, 0);
+        slot->last_rumble_ms = SDL_GetTicks();
+    }
+}
+
+/* Drain one slot's queued datagrams, keep the newest state, and run its
+ * presence state machine (hotplug on both edges). */
+static void S2UDP_PumpSlot(S2UDP_Slot *slot)
+{
+    Uint8 buf[128];
+    Uint64 now = SDL_GetTicks();
+
+    if (slot->sock < 0) {
+        return;
+    }
+    for (;;) {
+        ssize_t n = recv(slot->sock, buf, sizeof buf, 0);
+        if (n < 0) {
+            break; // EWOULDBLOCK: queue drained (or transient error; retry next pump)
+        }
+        if (n == S2UDP_STATE_SIZE && SDL_memcmp(buf, "S2B1", 4) == 0) {
+            slot->buttons = read_u32(buf + 8);
+            slot->lx = read_f32(buf + 12);
+            slot->ly = read_f32(buf + 16);
+            slot->rx = read_f32(buf + 20);
+            slot->ry = read_f32(buf + 24);
+            slot->lt = buf[28];
+            slot->rt = buf[29];
+            slot->last_state_ms = now;
+        } else if (n > 4 && n < 4 + (ssize_t)sizeof(slot->name) &&
+                   SDL_memcmp(buf, "S2N1", 4) == 0) {
+            // Bridge-provided display name (may be a user rename). A live
+            // rename hotplug-cycles the device so apps pick up the new name.
+            char incoming[sizeof(slot->name)];
+            SDL_memcpy(incoming, buf + 4, n - 4);
+            incoming[n - 4] = '\0';
+            if (SDL_strcmp(incoming, slot->name) != 0) {
+                SDL_strlcpy(slot->name, incoming, sizeof(slot->name));
+                if (slot->present) {
+                    slot->present = false;
+                    slot->last_state_ms = 0;   // re-add on next state packet
+                    SDL_PrivateJoystickRemoved(slot->instance_id);
+                }
+            }
+        }
+    }
+
+    if (now - slot->last_hello_ms >= HELLO_INTERVAL_MS) {
+        S2UDP_SendHello(slot);
+    }
+
+    if (!slot->present && slot->last_state_ms &&
+        now - slot->last_state_ms < PRESENCE_TIMEOUT_MS) {
+        slot->present = true;
+        slot->instance_id = SDL_GetNextObjectID();
+        SDL_PrivateJoystickAdded(slot->instance_id);
+    } else if (slot->present && now - slot->last_state_ms >= PRESENCE_TIMEOUT_MS) {
+        slot->present = false;
+        SDL_PrivateJoystickRemoved(slot->instance_id);
+    }
+}
+
+static void S2UDP_PumpAll(void)
+{
+    int k;
+    for (k = 0; k < S2UDP_MAX_SLOTS; ++k) {
+        S2UDP_PumpSlot(&s_slots[k]);
+    }
+}
+
+/* device_index counts only present slots; return that slot (or NULL). */
+static S2UDP_Slot *S2UDP_SlotForIndex(int device_index)
+{
+    int k;
+    for (k = 0; k < S2UDP_MAX_SLOTS; ++k) {
+        if (s_slots[k].present && device_index-- == 0) {
+            return &s_slots[k];
+        }
+    }
+    return NULL;
+}
+
+static int S2UDP_SlotNumber(const S2UDP_Slot *slot)
+{
+    return (int)(slot - s_slots);
+}
+
+static bool S2UDP_JoystickInit(void)
+{
+    int k;
+
+    for (k = 0; k < S2UDP_MAX_SLOTS; ++k) {
+        s_slots[k].sock = -1;
+    }
+    if (SDL_getenv("SDL_S2UDP_DISABLE")) {
+        return true; // stay registered but inert
+    }
+    for (k = 0; k < S2UDP_MAX_SLOTS; ++k) {
+        struct sockaddr_in addr;
+        int sock = socket(AF_INET, SOCK_DGRAM, 0);
+        if (sock < 0) {
+            continue;
+        }
+        fcntl(sock, F_SETFL, O_NONBLOCK);
+        SDL_zero(addr);
+        addr.sin_family = AF_INET;
+        addr.sin_port = htons(S2UDP_BASE_PORT + k);
+        addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        if (connect(sock, (struct sockaddr *)&addr, sizeof addr) < 0) {
+            close(sock);
+            continue;
+        }
+        s_slots[k].sock = sock;
+        S2UDP_SendHello(&s_slots[k]);
+    }
+    s_initialized = true;
+
+    /* Presence must be established synchronously for already-streaming
+     * controllers: apps (e.g. gopher64's input wizard) enumerate joysticks
+     * immediately after SDL_Init, before any Detect() pump has run. Wait
+     * briefly; when nothing at all is readable the bridge is idle or absent
+     * and we fall back to normal hotplug. */
+    {
+        Uint64 deadline = SDL_GetTicks() + 300;
+        while (SDL_GetTicks() < deadline) {
+            fd_set readfds;
+            struct timeval tv = { 0, 50 * 1000 };
+            int maxfd = -1;
+            FD_ZERO(&readfds);
+            for (k = 0; k < S2UDP_MAX_SLOTS; ++k) {
+                if (s_slots[k].sock >= 0) {
+                    FD_SET(s_slots[k].sock, &readfds);
+                    if (s_slots[k].sock > maxfd) {
+                        maxfd = s_slots[k].sock;
+                    }
+                }
+            }
+            if (maxfd < 0 || select(maxfd + 1, &readfds, NULL, NULL, &tv) <= 0) {
+                break; // timeout with nothing readable: bridge idle or absent
+            }
+            S2UDP_PumpAll();
+        }
+    }
+    return true;
+}
+
+static int S2UDP_JoystickGetCount(void)
+{
+    int k, count = 0;
+    for (k = 0; k < S2UDP_MAX_SLOTS; ++k) {
+        if (s_slots[k].present) {
+            ++count;
+        }
+    }
+    return count;
+}
+
+static void S2UDP_JoystickDetect(void)
+{
+    S2UDP_PumpAll();
+}
+
+static bool S2UDP_JoystickIsDevicePresent(Uint16 vendor_id, Uint16 product_id, Uint16 version, const char *name)
+{
+    return S2UDP_JoystickGetCount() > 0 && vendor_id == 0x057E && product_id == 0x2069;
+}
+
+static const char *S2UDP_JoystickGetDeviceName(int device_index)
+{
+    static const char *names[S2UDP_MAX_SLOTS] = {
+        "Switch 2 Controller (Bluetooth)",
+        "Switch 2 Controller (Bluetooth 2)",
+        "Switch 2 Controller (Bluetooth 3)",
+        "Switch 2 Controller (Bluetooth 4)",
+    };
+    S2UDP_Slot *slot = S2UDP_SlotForIndex(device_index);
+    if (slot && slot->name[0]) {
+        return slot->name;
+    }
+    return names[slot ? S2UDP_SlotNumber(slot) : 0];
+}
+
+static const char *S2UDP_JoystickGetDevicePath(int device_index)
+{
+    static const char *paths[S2UDP_MAX_SLOTS] = {
+        "udp://127.0.0.1:24800", "udp://127.0.0.1:24801",
+        "udp://127.0.0.1:24802", "udp://127.0.0.1:24803",
+    };
+    S2UDP_Slot *slot = S2UDP_SlotForIndex(device_index);
+    return paths[slot ? S2UDP_SlotNumber(slot) : 0];
+}
