+static void ReleaseVendorInterface(SDL_DriverSwitch2_Context *ctx)
+{
+#ifdef SDL_PLATFORM_MACOS
+    if (ctx->interface_claimed) {
+        ctx->libusb->release_interface(ctx->device_handle, ctx->interface_number);
+        ctx->interface_claimed = false;
+    }
+    if (ctx->own_device_handle && ctx->device_handle) {
+        ctx->libusb->close(ctx->device_handle);
+    }
+    ctx->device_handle = NULL;
+    ctx->own_device_handle = false;
+    if (ctx->usb_context) {
+        ctx->libusb->exit(ctx->usb_context);
+        ctx->usb_context = NULL;
+    }
+#else
+    (void)ctx;
+#endif
+}
+
+static bool AcquireVendorInterface(SDL_DriverSwitch2_Context *ctx)
+{
+#ifdef SDL_PLATFORM_MACOS
+    if (ctx->device_handle) {
+        return true;
+    }
+    if (!ctx->libusb) {
+        return false;
+    }
+    if (ctx->libusb->init(&ctx->usb_context) != 0) {
+        ctx->usb_context = NULL;
+        return false;
+    }
+    {
+        libusb_device **usb_list = NULL;
+        ssize_t usb_count = ctx->libusb->get_device_list(ctx->usb_context, &usb_list);
+        for (ssize_t di = 0; di < usb_count; di++) {
+            struct libusb_device_descriptor desc;
+            if (ctx->libusb->get_device_descriptor(usb_list[di], &desc) == 0 &&
+                desc.idVendor == ctx->device->vendor_id &&
+                desc.idProduct == ctx->device->product_id) {
+                if (ctx->libusb->open(usb_list[di], &ctx->device_handle) == 0) {
+                    ctx->own_device_handle = true;
+                    break;
+                }
+            }
+        }
+        if (usb_list) {
+            ctx->libusb->free_device_list(usb_list, 1);
+        }
+    }
+    if (!ctx->device_handle) {
+        ctx->libusb->exit(ctx->usb_context);
+        ctx->usb_context = NULL;
+        return false;
+    }
+    if (!FindBulkEndpoints(ctx->libusb, ctx->device_handle, &ctx->interface_number, &ctx->out_endpoint, &ctx->in_endpoint)) {
+        ReleaseVendorInterface(ctx);
+        return false;
+    }
+    if (ctx->libusb->claim_interface(ctx->device_handle, ctx->interface_number) < 0) {
+        ReleaseVendorInterface(ctx);
+        return false;
+    }
+    ctx->interface_claimed = true;
+    return true;
+#else
+    return ctx->device_handle != NULL;
+#endif
+}
