+static SDL_GUID S2UDP_JoystickGetDeviceGUID(int device_index)
+{
+    /* Distinct driver signature 'u' keeps these GUIDs from colliding with
+     * mapping-database entries for the USB/HIDAPI flavors of this pad;
+     * driver_data carries the slot so each controller's GUID is unique. */
+    S2UDP_Slot *slot = S2UDP_SlotForIndex(device_index);
+    return SDL_CreateJoystickGUID(SDL_HARDWARE_BUS_BLUETOOTH, 0x057E, 0x2069, 0,
+                                  "Nintendo", "Switch 2 Pro Controller", 'u',
+                                  slot ? (Uint8)S2UDP_SlotNumber(slot) : 0);
+}
+
+static SDL_JoystickID S2UDP_JoystickGetDeviceInstanceID(int device_index)
+{
+    S2UDP_Slot *slot = S2UDP_SlotForIndex(device_index);
+    return slot ? slot->instance_id : 0;
+}
+
+static bool S2UDP_JoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+    S2UDP_Slot *slot = S2UDP_SlotForIndex(device_index);
+    if (!slot) {
+        return SDL_SetError("S2UDP joystick %d not present", device_index);
+    }
+    joystick->nbuttons = 21;
+    joystick->naxes = 6;
+    joystick->nhats = 0;
+    joystick->hwdata = (struct joystick_hwdata *)slot;
+    return true;
+}
+
+static bool S2UDP_JoystickRumble(SDL_Joystick *joystick, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble)
+{
+    S2UDP_Slot *slot = (S2UDP_Slot *)joystick->hwdata;
+    if (!slot) {
+        return SDL_Unsupported();
+    }
+    slot->rumble_strong = low_frequency_rumble;
+    slot->rumble_weak = high_frequency_rumble;
+    S2UDP_SendRumble(slot);
+    return true;
+}
